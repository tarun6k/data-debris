<plist version="1.0">
<!--
  Every URL and hostname the app shows or calls, per build configuration.
  Nothing here is secret (Paddle tokens and price ids stay in .env / Info.plist).
  Debug builds may override LicenseWorkerURL with LICENSE_WORKER_URL in the
  repo .env, e.g. to point at a deployed sandbox worker.
-->
<dict>
	<key>Debug</key>
	<dict>
		<key>PrivacyPolicyURL</key>
		<string>https://datadebris.app/privacy</string>
		<key>TermsURL</key>
		<string>https://datadebris.app/terms</string>
		<key>SecurityURL</key>
		<string>https://datadebris.app/security</string>
		<key>CustomerPortalURL</key>
		<string>https://sandbox-customer-portal.paddle.com/</string>
		<key>UpdateHost</key>
		<string>updates.datadebris.app</string>
		<key>UpdateFeedURL</key>
		<string>https://updates.datadebris.app/appcast.xml</string>
		<key>LicenseWorkerURL</key>
		<string>http://127.0.0.1:8787</string>
		<key>SupportEmail</key>
		<string>support@datadebris.app</string>
	</dict>
	<key>Release</key>
	<dict>
		<key>PrivacyPolicyURL</key>
		<string>https://datadebris.app/privacy</string>
		<key>TermsURL</key>
		<string>https://datadebris.app/terms</string>
