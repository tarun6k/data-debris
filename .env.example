# Data Debris — Paddle configuration template. Copy to .env and fill in.
# .env is gitignored; never commit real values (see CLAUDE.md).
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_1Y_RECURRING=
PADDLE_PRICE_1Y_ONETIME=
PADDLE_PRICE_3Y_RECURRING=
PADDLE_PRICE_3Y_ONETIME=
# License worker (see services/license-worker/README.md)
LICENSE_SIGNING_KEY=
RESEND_API_KEY=
# App-side purchase config (Phase 7B). Debug builds read this file;
# http://127.0.0.1:8787 while `wrangler dev` serves the worker.
LICENSE_WORKER_URL=
